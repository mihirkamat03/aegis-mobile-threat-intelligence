<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Solid Background: Clean cool slate canvas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F4F7FC" />
        </shape>
    </item>

    <!-- Top Primary Radiant Azure Glow (High-tech cybersecurity atmosphere) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38356AE6"
                android:centerColor="#14356AE6"
                android:endColor="#00F4F7FC"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top-Right Cyber Violet Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:startColor="#2C6366F1"
                android:centerColor="#0E6366F1"
                android:endColor="#00F4F7FC"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top-Left Luminous Electric Cyan Accent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2400B4D8"
                android:centerColor="#0A00B4D8"
                android:endColor="#00F4F7FC"
                android:type="linear" />
        </shape>
    </item>

    <!-- Center Soft Horizon Glow (casts light behind middle cards) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#14356AE6"
                android:centerColor="#00F4F7FC"
                android:endColor="#106366F1"
                android:type="linear" />
        </shape>
    </item>

    <!-- Bottom Soft Ground Uplight -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#16356AE6"
                android:centerColor="#04356AE6"
                android:endColor="#00F4F7FC"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
