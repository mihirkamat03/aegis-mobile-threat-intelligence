<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Solid Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aegis_bg" />
        </shape>
    </item>

    <!-- Top-Right Subtle Blue/Indigo Ambient Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:startColor="#0D356AE6"
                android:centerColor="#04356AE6"
                android:endColor="#00F6F8FC"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top-Left Extremely Subtle Violet/Blue Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0A6366F1"
                android:centerColor="#036366F1"
                android:endColor="#00F6F8FC"
                android:type="linear" />
        </shape>
    </item>

    <!-- Lower Area Soft Cool Ambient Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#06356AE6"
                android:endColor="#00F6F8FC"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
