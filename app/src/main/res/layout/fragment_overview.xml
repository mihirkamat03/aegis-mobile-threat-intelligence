<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow_light"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_3xl">

        <!-- Hero Section: Spacious Device Health & Visual Risk Centerpiece -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_sm">

            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="AEGIS SECURITY POSTURE"
                android:textColor="@color/aegis_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceStatus"
                style="@style/AEGIS.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_badge_safe"
                android:letterSpacing="0.08"
                android:text="DEVICE PROTECTED"
                android:textColor="@color/aegis_safe"
                android:textSize="12sp" />

            <!-- The Visual Centerpiece: Ambient Glow Layer + Custom Animated Risk Ring -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <View
                    android:id="@+id/viewHeroAmbientGlow"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glow_hero_center" />

                <com.aether.aegis.ui.components.RiskRingView
                    android:id="@+id/riskRingOverview"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvActiveThreatSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:letterSpacing="0.02"
                android:text="4 correlated signals detected"
                android:textColor="@color/aegis_text_secondary"
                android:textSize="@dimen/text_secondary" />

            <!-- Compact Premium Metric Cards Row (Threat Risk & Privacy Risk) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <!-- Threat Risk Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardThreatMetric"
                    style="@style/AEGIS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_2xs"
                    android:layout_weight="1"
                    app:strokeColor="@color/aegis_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/threat_risk"
                            android:textColor="@color/aegis_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvThreatScore"
                                style="@style/AEGIS.Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/aegis_danger"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="84" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="/ 100"
                                android:textColor="@color/aegis_text_muted"
                                android:textSize="@dimen/text_technical" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbThreatRisk"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="84"
                            android:progressDrawable="@drawable/progress_bar_horizontal_danger" />

                        <TextView
                            android:id="@+id/tvThreatDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/aegis_text_secondary"
                            android:textSize="10sp"
                            tools:text="↑ 18 from baseline" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Privacy Risk Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPrivacyMetric"
                    style="@style/AEGIS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_2xs"
                    android:layout_weight="1"
                    app:strokeColor="@color/aegis_border">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="@string/privacy_risk"
                            android:textColor="@color/aegis_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPrivacyScore"
                                style="@style/AEGIS.Text.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/aegis_warning"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="68" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="/ 100"
                                android:textColor="@color/aegis_text_muted"
                                android:textSize="@dimen/text_technical" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbPrivacyRisk"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="68"
                            android:progressDrawable="@drawable/progress_bar_horizontal_warning" />

                        <TextView
                            android:id="@+id/tvPrivacyDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/aegis_text_secondary"
                            android:textSize="10sp"
                            tools:text="↑ 21 from baseline" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <!-- Premium Correlated Threat Investigation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImmediateAction"
            style="@style/AEGIS.Card.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginEnd="@dimen/spacing_md"
            app:strokeColor="@color/aegis_danger_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Header: Badge & Score -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCorrelatedTag"
                        style="@style/AEGIS.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_danger"
                        android:letterSpacing="0.08"
                        android:text="CORRELATED THREAT"
                        android:textColor="@color/aegis_danger"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvCorrelatedThreatBadge"
                        style="@style/AEGIS.Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="84 / 100 · CRITICAL"
                        android:textColor="@color/aegis_danger"
                        android:textSize="@dimen/text_technical"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- App Name & Subtitle -->
                <TextView
                    android:id="@+id/tvCorrelatedAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="QuickPDF Reader"
                    android:textColor="@color/aegis_text_primary"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvImmediateActionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Multiple signals indicate coordinated privacy and network risk."
                    android:textColor="@color/aegis_text_secondary"
                    android:textSize="@dimen/text_secondary" />

                <!-- Evidence Chips Container -->
                <LinearLayout
                    android:id="@+id/llEvidenceChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_evidence_active"
                        android:letterSpacing="0.04"
                        android:text="MICROPHONE"
                        android:textColor="@color/aegis_warning"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipBehaviour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_evidence_active"
                        android:letterSpacing="0.04"
                        android:text="BEHAVIOUR"
                        android:textColor="@color/aegis_warning"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipDomain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_chip_evidence_active"
                        android:letterSpacing="0.04"
                        android:text="SUSPICIOUS DOMAIN"
                        android:textColor="@color/aegis_danger"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipIntel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_evidence_active"
                        android:letterSpacing="0.04"
                        android:text="THREAT INTEL"
                        android:textColor="@color/aegis_danger"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Action Button Hierarchy: Solid Primary CTA + Subtle Secondary CTA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInvestigateNow"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:backgroundTint="@color/aegis_danger"
                        android:text="Investigate"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_secondary"
                        android:textStyle="bold"
                        app:cornerRadius="21dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickBlock"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/simulate_block_button"
                        android:textColor="@color/aegis_info"
                        android:textSize="@dimen/text_secondary"
                        android:textStyle="bold"
                        app:cornerRadius="21dp"
                        app:strokeColor="@color/aegis_info_stroke" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Top Risky Apps (Clean Header + Compact Rows) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.01"
                android:text="@string/top_risky_apps"
                android:textColor="@color/aegis_text_primary"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvViewAllApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/spacing_2xs"
                android:text="@string/view_all"
                android:textColor="@color/aegis_info"
                android:textSize="@dimen/text_secondary"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTopRiskyApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_app" />

        <!-- Section: Recent Activity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_md"
            android:letterSpacing="0.01"
            android:text="@string/recent_security_events"
            android:textColor="@color/aegis_text_primary"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOverviewActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_activity_event" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
