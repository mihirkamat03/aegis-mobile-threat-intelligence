<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aegis_bg">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aegis_surface"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="AEGIS"
            android:textColor="@color/aegis_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLiveStatus"
            style="@style/AEGIS.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/bg_badge_safe"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:letterSpacing="0.06"
            android:text="● LIVE"
            android:textColor="@color/aegis_safe"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvLogo"
            app:layout_constraintStart_toEndOf="@+id/tvLogo"
            app:layout_constraintTop_toTopOf="@+id/tvLogo" />

        <!-- Command-Center Demo Action Control -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDemoScenario"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/aegis_info_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.04"
            android:text="Start Demo"
            android:textColor="@color/aegis_info"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_play"
            app:iconPadding="4dp"
            app:iconSize="11dp"
            app:iconTint="@color/aegis_info"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/aegis_info_stroke"
            app:strokeWidth="1dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Top Hairline Divider -->
    <View
        android:id="@+id/topBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/aegis_border"
        app:layout_constraintTop_toBottomOf="@+id/topBar" />

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavDivider"
        app:layout_constraintTop_toBottomOf="@+id/topBarDivider" />

    <!-- Bottom Nav Top Hairline Divider -->
    <View
        android:id="@+id/bottomNavDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/aegis_border"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/aegis_surface"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemRippleColor="#15356AE6"
        app:itemTextColor="@color/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
