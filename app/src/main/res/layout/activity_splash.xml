<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow_light">

    <!-- Splash Centerpiece Content Container -->
    <LinearLayout
        android:id="@+id/llSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Shield Emblem Container with Subtle Outer Halo -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp">

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glow_hero_center" />

            <FrameLayout
                android:id="@+id/flSplashEmblem"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_badge_info">

                <ImageView
                    android:id="@+id/ivSplashShield"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/aegis_info" />
            </FrameLayout>
        </FrameLayout>

        <!-- Product Name Wordmark -->
        <TextView
            android:id="@+id/tvSplashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:letterSpacing="0.14"
            android:text="AEGIS"
            android:textColor="@color/aegis_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle Mission Statement -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:lineSpacingExtra="3dp"
            android:text="@string/tagline"
            android:textColor="@color/aegis_text_secondary"
            android:textSize="12sp" />

        <!-- Micro Status Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/aegis_info" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:letterSpacing="0.08"
                android:text="INITIALIZING ON-DEVICE CORRELATION ENGINE"
                android:textColor="@color/aegis_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Security Vault Guarantee -->
    <TextView
        android:id="@+id/tvSplashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:letterSpacing="0.06"
        android:text="STRICT ON-DEVICE PRIVACY PRESERVING ARCHITECTURE"
        android:textColor="@color/aegis_text_muted"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
